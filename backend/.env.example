# --- 必要 ---
DATABASE_URL=sqlite:///./app.db
SECRET_KEY=change-me-to-a-long-random-string

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- 攻擊意圖預測（皆為可選）---
# 雙通道模型 checkpoint（預設 ../STGCN/checkpoints/intent_model.pt；不存在時使用 規則+AHP 基線）
# INTENT_MODEL_PATH=
# 自訂武器偵測模型（預設使用 COCO 的 knife / scissors / baseball bat）
# WEAPON_MODEL_PATH=
# WEAPON_CONF=0.30
# WEAPON_EVERY_N=2

# --- RAG 向量資料庫（可選；未設定時用本機向量庫）---
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=

# --- 推播（L3 以上）---
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
# NOTIFY_WEBHOOK_FORMAT=slack   # slack | discord | generic
# NOTIFY_MIN_LEVEL=L3

# --- 其他 ---
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# EXTRA_SOURCES=rtsp://user:pass@192.168.1.10:554/stream1
